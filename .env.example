# 本地开发环境变量示例
# 复制本文件为 .env.local 并填入真实值即可在本地使用完整的点赞功能

# EdgeOne Pages 点赞接口完整 URL（前端只调此地址，不含任何密钥）
VITE_LIKES_API_URL=https://likes.aioceanography.top/api/like

# 以下变量在 GitHub Actions 中会自动注入；本地开发如需从 raw 读取 likes.json 可手动填写
# VITE_GH_OWNER=scenty
# VITE_GH_REPO=AI-Oceanography-Course
# VITE_GH_BRANCH=main
